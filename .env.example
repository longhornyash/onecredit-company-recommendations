# Export variables in your shell before starting processes; no automatic dotenv loading.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/companies
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
MODEL_CACHE=.models
SEARCH_MODE=auto
# DATABASE_SCHEMA=public (the pipeline creates and reports a new isolated schema)
# TEST_DATABASE_URL must explicitly identify a disposable database for integration tests.
# TEST_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
